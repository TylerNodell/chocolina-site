{
  "name": "material-kit-pro-react",
  "version": "1.8.0",
  "private": true,
  "dependencies": {
    "@material-ui/core": "4.3.2",
    "@material-ui/icons": "4.2.1",
    "animate.css": "3.7.2",
    "classnames": "2.2.6",
    "history": "4.9.0",
    "moment": "2.31.0",
    "nouislider": "14.0.2",
    "prop-types": "15.7.2",
    "react": "16.9.0",
    "react-animate-on-scroll": "2.1.5",
    "react-datetime": "2.16.3",
    "react-dom": "16.9.0",
    "react-google-maps": "9.4.5",
    "react-image-gallery": "0.8.18",
    "react-router-dom": "5.0.1",
    "react-scripts": "5.0.1",
    "react-slick": "0.25.2",
    "react-swipeable-views": "0.13.3",
    "react-tagsinput": "3.19.0",
    "sass": "1.77.8"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build && gulp licenses",
    "test": "react-scripts test --env=jsdom",
    "eject": "react-scripts eject",
    "lint:check": "eslint . --ext=js,jsx;  exit 0",
    "lint:fix": "eslint . --ext=js,jsx --fix;  exit 0",
    "install:clean": "rm -rf node_modules/ && rm -rf package-lock.json && npm install && npm start",
    "compile-sass": "sass --load-path=. --no-source-map src/assets/scss/material-kit-pro-react.scss src/assets/css/material-kit-pro-react.css",
    "minify-sass": "sass --load-path=. --no-source-map src/assets/scss/material-kit-pro-react.scss src/assets/css/material-kit-pro-react.min.css --style compressed",
    "map-sass": "sass --load-path=. src/assets/scss/material-kit-pro-react.scss src/assets/css/material-kit-pro-react.css --source-map"
  },
  "devDependencies": {
    "gulp": "5.0.1",
    "gulp-append-prepend": "1.0.8"
  },
  "optionalDependencies": {
    "@types/googlemaps": "3.37.3",
    "@types/markerclustererplus": "2.1.33",
    "eslint-config-prettier": "6.0.0",
    "eslint-plugin-prettier": "3.1.0",
    "eslint-plugin-react": "7.37.5",
    "prettier": "1.18.2",
    "typescript": "3.5.3"
  },
  "overrides": {
    "@svgr/webpack": "^6.5.1",
    "resolve-url-loader": "^5.0.0",
    "serialize-javascript": "^7.0.5",
    "underscore": "^1.13.8",
    "webpack-dev-middleware": "^7.4.5",
    "isomorphic-fetch": "^3.0.0",
    "postcss-selector-parser": "^7.1.6",
    "react-swipeable-views": {
      "@babel/runtime": "^7.26.10"
    },
    "sockjs": {
      "uuid": "^11.1.1"
    },
    "jsdom": {
      "http-proxy-agent": "^5.0.0"
    }
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
